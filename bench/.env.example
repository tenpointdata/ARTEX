# Benchmark subject instance (docker-compose.bench.yml). Copy to bench/.env and fill
# in. bench/.env is gitignored; this file holds no secrets and is committed.
# Every variable is passed to both containers as-is (no ${} interpolation, no quotes
# needed; Compose still reads $ specially, so write $$ for a literal $).

# Database password, used by both the bench Postgres and ARTEX. Required.
# The server percent-encodes it, so / ? % @ : and spaces are safe.
ARTEX_PG_PASSWORD=

# Held-out evaluation measures the prompts under test, not the lesson library:
# no lesson extraction or injection on a bench instance (see RSI.md, docs/rsi-lessons.md).
ARTEX_RSI_LESSONS=off

# LLM for the subject (or leave empty and configure profiles in the UI). The judge
# is configured on the runner side (JUDGE_*), never here: it must not be the subject.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Optional key for secrets at rest (32 bytes, base64 or hex). Empty: secret.key in the bench keys volume.
ARTEX_SECRET_KEY=

# No update banner or update requests on a measured instance.
ARTEX_UPDATE_CHECK=

# Noise profile and run budgets: leave unset for comparable runs unless the suite
# stamps them. Unset or 0 = unlimited. See .env.example at the repository root.
# ARTEX_NOISE_PROFILE=
# ARTEX_TASK_BUDGET_TOKENS=
# ARTEX_TASK_BUDGET_TURNS=
# ARTEX_INTENT_BUDGET_TOKENS=
# ARTEX_INTENT_BUDGET_TURNS=

# Agent egress filter (egress.sh). It denies agent processes the Docker host gateway,
# so a corpus published on the host (run_bench.py --target-host host.docker.internal)
# is unreachable until that one address is allowed. Find it with
#   docker compose -f docker-compose.bench.yml exec artex-bench getent ahostsv4 host.docker.internal
# and allow only that IP, and only on a host whose other local services the agent
# may reach. A corpus on another machine or network needs no exception.
# ARTEX_EGRESS_ALLOW=
# ARTEX_EGRESS_DENY=
