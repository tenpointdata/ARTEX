+++ b/proxy/keepalive_host_test.go
@@ -0,0 +1,42 @@
+package proxy
+
+import (
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"testing"
+	"time"
+)
+
+// A keep-alive plain HTTP proxy connection that names a second host must
+// reach that host, not the server dialled for the first request.
+func TestProxyKeepAliveHostChange(t *testing.T) {
+	serve := func(body string) string {
+		ln, err := net.Listen("tcp", "127.0.0.1:0")
+		handleError(t, err)
+		srv := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			io.WriteString(w, body)
+		})}
+		go srv.Serve(ln)
+		t.Cleanup(func() { srv.Close() })
+		return "http://" + ln.Addr().String() + "/"
+	}
+	urlA, urlB := serve("A"), serve("B")
+
+	p, err := NewProxy(&Options{Addr: "127.0.0.1:29091"})
+	handleError(t, err)
+	go p.Start()
+	t.Cleanup(func() { p.Close() })
+	time.Sleep(100 * time.Millisecond)
+
+	tr := &http.Transport{
+		Proxy:           func(*http.Request) (*url.URL, error) { return url.Parse("http://127.0.0.1:29091") },
+		MaxConnsPerHost: 1, // one client connection to the proxy, reused for both hosts
+	}
+	t.Cleanup(tr.CloseIdleConnections)
+	client := &http.Client{Transport: tr}
+	testSendRequest(t, urlA, client, "A")
+	testSendRequest(t, urlB, client, "B")
+	testSendRequest(t, urlA, client, "A")
+}
